# ─── App ──────────────────────────────────────────────────────────────────────
APP_SECRET=changeme_32chars_minimum_please_change
APP_PORT=8080
APP_ENV=production

# ─── Database ─────────────────────────────────────────────────────────────────
DB_PATH=/data/velar.db

# ─── WireGuard ────────────────────────────────────────────────────────────────
WG_CONFIG_DIR=/etc/wireguard
# Public IP or DDNS hostname that peers will connect to
WG_HOST=0.0.0.0
# Set to true to disable actual wg command calls (for development/testing)
WG_MOCK=false

# ─── AdGuard Home ─────────────────────────────────────────────────────────────
ADGUARD_URL=http://localhost:3001
ADGUARD_USER=admin
ADGUARD_PASSWORD=changeme

# ─── CORS ─────────────────────────────────────────────────────────────────────
CORS_ORIGIN=http://localhost:5173

# ─── SMTP (optional) ──────────────────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
