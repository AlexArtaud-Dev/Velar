# ─── Slave mode ───────────────────────────────────────────────────────────────
VELAR_MODE=slave

# ─── App ──────────────────────────────────────────────────────────────────────
# Must be at least 32 characters — used to encrypt WireGuard private keys.
# Generate one with: openssl rand -base64 32
APP_SECRET=changeme_32chars_minimum_please_change
APP_PORT=8080
APP_ENV=production

# ─── Database ─────────────────────────────────────────────────────────────────
DB_PATH=/data/velar.db

# ─── WireGuard ────────────────────────────────────────────────────────────────
WG_CONFIG_DIR=/etc/wireguard
# Public IP or hostname that VPN peers will use to reach this slave
WG_HOST=0.0.0.0

# ─── AdGuard Home ─────────────────────────────────────────────────────────────
# URL of the AdGuard Home instance running alongside this slave.
# After the first-boot setup wizard, AdGuard moves its web UI to port 3001.
# Leave these set so the Velar API can proxy AdGuard management calls from the master.
ADGUARD_URL=http://localhost:3001
ADGUARD_USER=admin
ADGUARD_PASSWORD=

# ─── Slave token reset (optional) ────────────────────────────────────────────
# Set to true to regenerate the vs_ token on next boot (e.g. if you lost it).
# Remove or set back to false after the new token has been copied.
SLAVE_TOKEN_RESET=false
